<Layouts.app flash={@flash}>
  <div class="grid gap-x-6 gap-y-6 sm:grid-cols-3">
    <.panel id="websocket-stats" title="Websockets">
      <.stat_row
        id="stat-connections"
        label="Connections"
        value={@websocket_stats.connected.count}
        value_class={if(@websocket_stats.connected.count == 0, do: "text-error", else: nil)}
      />
      <.stat_row
        id="stat-disconnects"
        label="Disconnects"
        value={@websocket_stats.disconnected.count}
      />
      <.stat_row id="stat-msg-rate" label="Messages / s" value={@msg_rate || "–"} />
    </.panel>

    <.panel id="event-store-stats" title="Event store">
      <.stat_row id="stat-events" label="Events" value={format_int(@event_count)} />
      <.stat_row id="stat-markets" label="Markets" value={format_int(@market_count)} />
    </.panel>

    <.panel id="lifespan-stats" title="Avg socket lifespan">
      <.stat_row
        id="stat-lifespan-connected"
        label="Connected"
        value={format_duration(@websocket_stats.connected.avg_lifespan)}
      />
      <.stat_row
        id="stat-lifespan-disconnected"
        label="Disconnected"
        value={format_duration(@websocket_stats.disconnected.avg_lifespan)}
      />
    </.panel>
  </div>
</Layouts.app>
