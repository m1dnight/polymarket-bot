<Layouts.app flash={@flash}>
  <Layouts.dashboard_tabs active={:events} />

  <div
    id="events"
    phx-update="stream"
    phx-hook=".Blink"
    class="flex flex-wrap content-start gap-0.5"
  >
    <div id="events-empty" class="hidden text-sm text-base-content/50 only:block">
      No events stored yet.
    </div>
    <div
      :for={{id, event} <- @streams.events}
      id={id}
      title={"#{event.external_id} · #{Calendar.strftime(event.updated_at, "%Y-%m-%d %H:%M:%S")}"}
      class={["event-cell size-3 rounded-sm", event.closed && "opacity-40"]}
      style={decay_delay(event)}
    />
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".Blink">
    export default {
      mounted() {
        this.handleEvent("blink", ({ids}) => {
          // restart the green→transparent decay from zero via an
          // animation:none round-trip. Batched: all writes, ONE forced
          // reflow, all writes — a reflow per cell janks the whole grid.
          // Resetting the shorthand also drops the server-rendered
          // animation-delay, so the cell flashes full green.
          const cells = []
          for (const id of ids) {
            const cell = document.getElementById(id)
            if (cell) cells.push(cell)
          }
          for (const cell of cells) cell.style.animation = "none"
          void document.body.offsetWidth
          for (const cell of cells) cell.style.animation = ""
        })
      }
    }
  </script>
</Layouts.app>
