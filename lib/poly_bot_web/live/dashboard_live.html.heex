<Layouts.app flash={@flash}>
  <div class="grid gap-x-6 gap-y-6 sm:grid-cols-3">
    <.panel id="websocket-stats" title="Websocket pool">
      <:meta>
        <span :if={@sockets_loading?} id="sockets-loading">
          <.icon
            name="hero-arrow-path"
            class="size-3 motion-safe:animate-spin text-base-content/40"
          />
        </span>
      </:meta>
      <%!-- The red is deliberately NOT gated on @sockets_loading?: gating would blink
           the alert off on every refresh tick during a real outage, and hide one
           entirely behind a stalled worker fetch. The header spinner disambiguates
           "refreshing" from "genuinely zero". --%>
      <.stat_row
        id="stat-connections"
        label="Connections"
        value={@connection_count}
        value_class={if(@connection_count == 0, do: "text-error", else: nil)}
      />
      <.stat_row
        id="stat-pending-assets"
        label="Pending resub"
        value={@pending_asset_count}
        value_class={if(@pending_asset_count > 0, do: "text-warning", else: nil)}
      />
      <.stat_row
        id="stat-avg-lifespan"
        label="Avg lifespan"
        value={format_duration(@avg_lifespan)}
      />
      <.stat_row id="stat-avg-assets" label="Avg assets / conn" value={@avg_assets || "–"} />
      <.stat_row id="stat-msg-rate" label="Messages / s" value={@msg_rate || "–"} />
    </.panel>

    <.panel id="event-store-stats" title="Event store">
      <.stat_row id="stat-events" label="Events" value={format_int(@event_count)} />
      <.stat_row id="stat-markets" label="Markets" value={format_int(@market_count)} />
    </.panel>

    <.panel id="lifespan-stats" title="Avg socket lifespan">
      <.stat_row
        id="stat-lifespan-connected"
        label="Connected"
        value={format_duration(@lifespan_stats.connected)}
      />
      <.stat_row
        id="stat-lifespan-disconnected"
        label="Disconnected"
        value={format_duration(@lifespan_stats.disconnected)}
      />
    </.panel>
  </div>
</Layouts.app>
